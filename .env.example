# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# RevenueCat
REVENUECAT_WEBHOOK_SECRET=

# App
ENV=dev
CORS_ORIGINS=*

# Gemini (Ebced / ilm-i hurûf)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AI zaman aşımı / retry bütçesi (saniye; boşsa bu varsayılanlar kullanılır)
# Deneme başı: bağlantı / kısa çağrı (sohbet, vision) / uzun JSON yorumu (natal ~80s)
AI_CONNECT_TIMEOUT_SECONDS=10
AI_TIMEOUT_SECONDS=60
AI_LONG_TIMEOUT_SECONDS=150
# Gemini fallback istek başı
GEMINI_TIMEOUT_SECONDS=60
# Sağlayıcı başına en fazla deneme (yalnız geçici hatalarda: timeout/429/5xx/bağlantı)
AI_MAX_ATTEMPTS=2
# Tek AI üretiminin toplam tavanı (OpenAI + retry + Gemini): sohbet/vision, JSON yorum
AI_REQUEST_BUDGET_SECONDS=120
AI_LONG_REQUEST_BUDGET_SECONDS=270
# Tek HTTP isteğindeki tüm AI çağrılarının toplam tavanı (ör. kahve: 3 vision + yorum)
AI_REQUEST_DEADLINE_SECONDS=360
