# Caddy sertifikaları Let's Encrypt'ten kendisi alır ve yeniler.

(backend) {
	encode zstd gzip
	# Kahve/el/yüz falı fotoğrafları için yükleme sınırı (3 foto).
	request_body {
		max_size 40MB
	}
	# Caddy host ağında: API'ye yerel porttan ulaşır.
	reverse_proxy 127.0.0.1:8000 {
		# Uzun AI okumaları (natal ~80 sn) kesilmesin.
		transport http {
			read_timeout 400s
			write_timeout 400s
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}

# Uygulamaların konuştuğu API.
{$API_DOMAIN} {
	import backend
}

# Web sitesi + web uygulaması (Next.js, dev kullanıcısı, 127.0.0.1:3002).
# Yasal sayfalar, destek ve görseller backend'de kalır (App Store linkleri).
astrype.com {
	@backend path /legal/* /support /static/* /health
	handle @backend {
		import backend
	}
	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:3002
		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options nosniff
			-Server
		}
	}
}

www.astrype.com {
	redir https://astrype.com{uri} permanent
}
