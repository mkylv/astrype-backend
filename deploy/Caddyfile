# Caddy sertifikaları Let's Encrypt'ten kendisi alır ve yeniler.

(backend) {
	encode zstd gzip
	# Kahve/el/yüz falı fotoğrafları için yükleme sınırı (3 foto).
	request_body {
		max_size 40MB
	}
	reverse_proxy api:8000 {
		# Uzun AI okumaları (natal ~80 sn) kesilmesin.
		transport http {
			read_timeout 400s
			write_timeout 400s
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}

# Uygulamaların konuştuğu API.
{$API_DOMAIN} {
	import backend
}

# Tanıtım sitesi + yasal sayfalar (/legal/...) — Next.js sitesi Vercel'e
# geçene kadar backend'in kendi sitesi buradan sunulur.
astrype.com {
	import backend
}

www.astrype.com {
	redir https://astrype.com{uri} permanent
}
